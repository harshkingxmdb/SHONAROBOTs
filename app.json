{
  "name": "Shona Robot",
  "description": "Telegram group management bot with a built-in music system",
  "repository": "https://github.com/TeamAloneOp/EikoRobot",
  "logo": "https://files.catbox.moe/1gxuh7.jpg",
  "keywords": [
    "telegram",
    "bot",
    "management",
    "music",
    "pyrogram",
    "ptb"
  ],
  "env": {
    "TOKEN": {
      "description": "Bot token from @BotFather",
      "required": true
    },
    "DB_URL": {
      "description": "MongoDB connection URI (mongodb+srv://...)",
      "required": true
    },
    "API_ID": {
      "description": "Telegram API_ID from my.telegram.org",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API_HASH from my.telegram.org",
      "required": true
    },
    "ALONE_OWNER_ID": {
      "description": "Your Telegram user id (the bot owner)",
      "required": true
    },
    "LOG_GROUP_ID": {
      "description": "Log group id, starts with -100. Bot must be admin there (music uses it too)",
      "required": true
    },
    "SESSION1": {
      "description": "MUSIC: string session of the main music assistant account. Without it only the Robot runs (no music)",
      "required": false
    },
    "SESSION2": {
      "description": "MUSIC (optional): 2nd assistant account string session",
      "required": false
    },
    "SESSION3": {
      "description": "MUSIC (optional): 3rd assistant account string session",
      "required": false
    },
    "USER_STRING": {
      "description": "ROBOT (optional): string session of the robot's own user account (vc player). Not used for music",
      "required": false
    },
    "DB_URL2": {
      "description": "Optional: second MongoDB URI",
      "required": false
    },
    "SUDO_USERS": {
      "description": "Optional: sudo user ids separated by space",
      "required": false
    },
    "OWNER_ID": {
      "description": "Optional: extra owner id (defaults are in config.py)",
      "required": false
    },
    "SUPPORT_CHAT": {
      "description": "Optional: support group username without @",
      "required": false
    },
    "UPDATE_CHANNEL": {
      "description": "Optional: update channel username without @",
      "required": false
    },
    "BOT_NAME": {
      "description": "Optional: bot display name",
      "required": false
    },
    "BOT_USERNAME": {
      "description": "Optional: bot username with @",
      "required": false
    },
    "WEB_URL": {
      "description": "Optional: your Heroku app url (https://APPNAME.herokuapp.com) for keep-alive pings",
      "required": false
    }
  },
  "buildpacks": [
    {
      "url": "heroku-community/apt"
    },
    {
      "url": "heroku/python"
    }
  ],
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  }
}

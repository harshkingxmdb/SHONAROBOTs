# ---------- Manage bot (required) ----------
TOKEN=
DB_URL=
DB_URL2=
API_ID=
API_HASH=
ALONE_OWNER_ID=
LOG_GROUP_ID=            # bot (and the music assistant) must be able to post here
SUPPORT_CHAT=
UPDATE_CHANNEL=

# ---------- Music system (shares everything above) ----------
# Assistant account that joins voice chats. Pyrogram string session.
# Use a DIFFERENT account than your own if you can; if it is the same as USER_STRING the
# manage bot's user client is reused automatically.
USER_STRING=
# SESSION2=              # optional extra assistants
# SESSION3=

# Optional music tweaks (defaults are fine)
# MUSIC_MONGO_URL=       # default: DB_URL (music uses its own database "Anon", no clash)
# MUSIC_LOGGER_ID=       # default: LOG_GROUP_ID
# QUEUE_LIMIT=2000
# DURATION_LIMIT=17000
# AUDIO_QUALITY=HIGH     # HIGH / STUDIO
# VIDEO_QUALITY=HD_720p  # SD_480p / HD_720p / FHD_1080p
# API_URL=  API_KEY=  INFLEX_API_URL=  INFLEX_API_KEY=  SHRUTI_API_URL=  SHRUTI_API_KEY=
